#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_dir="$HOME/.local/share/node-v24.19.0"

if [[ ! -x "$node_dir/bin/node" || ! -d "$repo_root/node_modules" ]]; then
  echo "Orb dependencies are incomplete; run .agents/setup to repair them." >&2
  exit 1
fi

echo "Orb dependencies are ready."
