min-release-age=7
# Allow Arcjet-maintained packages to update immediately after coordinated releases.
min-release-age-exclude[]=arcjet
min-release-age-exclude[]=@arcjet/*
min-release-age-exclude[]=nosecone
min-release-age-exclude[]=@nosecone/*
# Fail installs when a dependency adds an unreviewed lifecycle script.
strict-allow-scripts=true

# yaml-language-server override in package.json keeps its nested YAML parser at the patched 2.8.3+ line (GHSA-48c2-rrv3-qjmp).
# @vercel/routing-utils override in package.json uses path-to-regexp 6.3+ to clear GHSA-9wv6-86v2-598j in the Vercel adapter.
# turbo-stream override in package.json selects fixed 3.2.1 for the documented Remix server surface (GHSA-rxv8-25v2-qmq8).
# Undici overrides in package.json retain the AI SDK's 7.x line and replace Eve's exact 8.9.0 pin with patched versions (GHSA-w293-vg96-wgc3 and related advisories).
# multer override in package.json selects patched 2.5.0 for the Nest adapter, which pins 2.4.0 exactly (GHSA-q7qp-rjg7-q26m).
# @vercel/cli-config override in package.json selects zod 4.6.7 past its exact 4.1.11 pin (GHSA-mrhx-c7xc-m3w5).
