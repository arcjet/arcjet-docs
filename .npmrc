min-release-age=7
# Allow Arcjet-maintained packages to update immediately after coordinated releases.
min-release-age-exclude[]=arcjet
min-release-age-exclude[]=@arcjet/*
min-release-age-exclude[]=nosecone
min-release-age-exclude[]=@nosecone/*
# Fail installs when a dependency adds an unreviewed lifecycle script.
strict-allow-scripts=true

# @vercel/routing-utils override in package.json uses path-to-regexp 6.3+ to clear GHSA-9wv6-86v2-598j in the Vercel adapter.
# turbo-stream override in package.json selects fixed 3.2.1 for the documented Remix server surface (GHSA-rxv8-25v2-qmq8).
# @vercel/cli-config override in package.json selects zod 4.6.7 past its exact 4.1.11 pin (GHSA-mrhx-c7xc-m3w5).
# @remix-run/node and @remix-run/server-runtime overrides in package.json point their optional typescript ^5.1.0 peer at the root TypeScript 6. Remix 2 is frozen at 2.17.5 and only uses the peer for type tooling.
# @vercel/analytics override in package.json points its optional @sveltejs/kit ^1 || ^2 peer at the root SvelteKit 3. Only its SvelteKit entry point uses the peer, and the Astro Vercel adapter does not load it.
# @nuxt/nitro-server override in package.json retains Nitro 2.13.5 and Archiver 7 (Nitro 2.13.6 requires the Archiver 8 major); remove when Nuxt is allowed past 4.6.3.
# @astrojs/starlight override in package.json retains MDX 8.0.1 and es-module-lexer 2 (Starlight 0.42.10 moves its lexer dependency to the major 3 line); remove when Starlight is allowed past 0.42.9.
