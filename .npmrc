min-release-age=7
# Allow Arcjet-maintained packages to update immediately after coordinated releases.
min-release-age-exclude[]=arcjet
min-release-age-exclude[]=@arcjet/*
min-release-age-exclude[]=nosecone
min-release-age-exclude[]=@nosecone/*
# Fail installs when a dependency adds an unreviewed lifecycle script.
strict-allow-scripts=true

# package.json scopes this override to sensitive-info-rampart: transformers 4.3.0 fixes high-severity transitive ONNX and archive issues in the documented Rampart detector.
