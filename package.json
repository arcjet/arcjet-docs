  },
  "name": "docs",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check --minimumSeverity warning && astro build",
    "dev": "astro dev --host",
    "prepare": "patch-package && npm --workspaces run check",
    "preview": "astro preview",
    "pw:install": "playwright install --with-deps chromium --only-shell",
    "pw:open": "playwright test --ui-host=0.0.0.0",
    "pw:run": "playwright test",
    "generate:legacy-f-redirects": "node --experimental-strip-types scripts/generate-legacy-f-redirects.ts"
  },
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "snippets/*"
  ],
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "turbo-stream": "3.2.1",
    "multer": "2.5.0",
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@remix-run/node": {
      "typescript": "$typescript"
    },
    "@remix-run/server-runtime": {
      "typescript": "$typescript"
    },
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
