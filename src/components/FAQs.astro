---
import { faqPageJsonLd, faqs } from "@/lib/faqs";

const jsonLd = JSON.stringify(faqPageJsonLd(faqs)).replaceAll("<", "\\u003c");
---

{
  faqs.map((faq) => (
    <details>
      <summary>
        <strong>{faq.question}</strong>
      </summary>
      {faq.answer.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </details>
  ))
}

<script is:inline type="application/ld+json" set:html={jsonLd} />
