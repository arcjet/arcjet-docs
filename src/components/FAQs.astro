---
import { faqPageJsonLd, faqs } from "@/lib/faqs";

const jsonLd =
  faqs.length > 0
    ? JSON.stringify(faqPageJsonLd(faqs)).replaceAll("<", "\\u003c")
    : undefined;
---

{
  faqs.map((faq) => (
    <details>
      <summary>
        <strong>{faq.question}</strong>
      </summary>
      {faq.answer.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </details>
  ))
}

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
