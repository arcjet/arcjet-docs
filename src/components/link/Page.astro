---
import type { HTMLAttributes } from "astro/types";
import { resolveHrefForCurrentSdk } from "@/lib/doc-routes";

type Props = HTMLAttributes<"a"> & {
  /**
   * Internal absolute path to link to e.g. `"/get-started"`.
   *
   * On SDK-scoped pages this is prefixed with `/sdk/{currentSdk}/` when that
   * page has an SDK-scoped route. Shared pages, and non-SDK pages, use the
   * href as-is.
   */
  href: string;
};

const { href, ...rest } = Astro.props;

if (!href) {
  throw new Error(`<Link.Page> requires an href prop.`);
}

const resolvedHref = await resolveHrefForCurrentSdk(Astro.url.pathname, href);
---

<a href={resolvedHref} {...rest}><slot /></a>
