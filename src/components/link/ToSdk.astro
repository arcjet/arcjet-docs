---
import type { HTMLAttributes } from "astro/types";
import { isSdkKey, type ArcjetSdkKey } from "@/lib/sdk";
import { resolveHrefForSdk } from "@/lib/doc-routes";

type Props = HTMLAttributes<"a"> & {
  /**
   * Internal absolute path to link to e.g. `"/get-started"`.
   */
  href: string;
  /**
   * The target SDK key to scope the link to e.g. `"node"`, `"next"`.
   *
   * Produces `/sdk/{sdk}/{path}` when the target SDK publishes that page.
   * Shared pages, which have no per-SDK route, use the href as-is.
   */
  sdk: ArcjetSdkKey;
};

const { href, sdk, ...rest } = Astro.props;

if (!sdk || !isSdkKey(sdk)) {
  throw new Error(
    `<Link.ToSdk> received invalid sdk="${sdk}". Expected a valid ArcjetSdkKey.`
  );
}

const resolvedHref = await resolveHrefForSdk(Astro.url.pathname, href, sdk);
---

<a href={resolvedHref} {...rest}><slot /></a>
