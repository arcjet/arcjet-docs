---
import SdkSwitcher from "@/components/SdkSwitcher";
import TOC from "@/components/TOC";
import { sdkFromPathname, sdkSwitcherOptions } from "@/lib/sdk";
import Default from "@astrojs/starlight/components/MobileTableOfContents.astro";

const pathname = Astro.url.pathname;
const activeSdkKey = sdkFromPathname(pathname);
const pageFrameworks = Astro.locals.starlightRoute.entry.data.frameworks;
const isAjTocHub =
    Astro.locals.starlightRoute.entry.data.ajToc != undefined && !activeSdkKey;
const showSwitcher =
    (!!activeSdkKey || isAjTocHub) &&
    sdkSwitcherOptions(pathname, pageFrameworks).length > 0;
---

{
    isAjTocHub ? (
        <TOC
            client:load
            astroEntry={Astro.locals.starlightRoute.entry}
            pathname={pathname}
            surface="mobile"
            includeSwitcher={showSwitcher}
        />
    ) : showSwitcher ? (
        <div class="mtoc-wrapper">
            <div class="mtoc-container">
                <div class="mtoc-sdk-control">
                    <SdkSwitcher
                        client:load
                        pathname={pathname}
                        pageFrameworks={pageFrameworks}
                        variant="mobile"
                    />
                </div>
                <Default />
            </div>
        </div>
    ) : (
        <div class="todo-remove">
            <Default />
        </div>
    )
}

<style>
    @layer starlight, arcjet;

    @layer arcjet.overrides {
        .mtoc-wrapper {
            mobile-starlight-toc {
                min-width: 0;

                nav {
                    position: unset;
                    border: none;

                    summary {
                        border: none;
                        gap: calc(var(--sp) * 2);
                        padding: 0;
                    }

                    .toggle {
                        background-color: var(--aj-palette-block-level2-blurBg);
                        border: none;
                    }

                    .dropdown {
                        position: fixed;
                        left: var(--mtoc-left);
                        right: 0;
                        width: 100vw;
                        max-width: calc(100vw - var(--mtoc-left));
                        z-index: 2;

                        top: calc(var(--Header-height) + var(--mtoc-height));

                        overflow-y: auto;

                        border: none;
                        backdrop-filter: blur(var(--blur1));
                        background: linear-gradient(
                            rgba(var(--sl-color-bg-rgb) / 1) 8px,
                            rgba(var(--sl-color-bg-rgb) / 0)
                        );

                        padding: 0 var(--sl-content-pad-x) calc(var(--sp) * 3);

                        a {
                            border: 0px;

                            border-radius: calc(var(--sp) * 0.5);
                            color: var(--aj-palette-txt-secondary);

                            transition: all var(--time-sm) var(--easing-default);

                            outline: none;

                            padding: calc(var(--sp) * 1) calc(var(--sp) * 1);
                            margin: calc(var(--sp) * 0.2) 0;
                            margin-left: calc(1rem * var(--depth));

                            &:hover,
                            &:focus {
                                background: var(--sidebar-link-hoverBg);
                                color: var(--aj-palette-txt-secondary);
                            }

                            &:active {
                                background: var(--sidebar-link-activeBg);
                            }

                            &[aria-current="true"] {
                                color: var(--aj-palette-txt-primary);
                                background: var(--sidebar-link-selectedBg);
                            }
                        }
                    }
                }
            }
        }
    }

    @layer arcjet.components {
        .mtoc-wrapper {
            --mtoc-left: 0;
            --mtoc-height: calc(8px * 11);

            position: fixed;
            top: var(--Header-height);
            height: var(--mtoc-height);
            width: 100%;
            z-index: 1;
        }

        @media (min-width: 50rem) {
            .mtoc-wrapper {
                --mtoc-left: var(--Sidebar-width);
            }
        }

        @media (min-width: 72rem) {
            .mtoc-wrapper {
                display: none;
            }
        }

        .mtoc-container {
            background-color: rgb(var(--sl-color-bg-rgb));
            box-sizing: border-box;
            display: flex;
            gap: calc(var(--sp) * 2);
            height: var(--mtoc-height);
            padding: calc(var(--sp) * 3) var(--sl-content-pad-x);
            position: relative;
            z-index: 1;
        }

        .mtoc-sdk-control {
            align-self: end;
            display: flex;
            flex: 1 1 auto;
            min-width: 0;
        }

        /* Disable mtoc gradient when sdk popover or .dropdown open */
        :root:not(:has(#mtoc-sdk:popover-open))
            .mtoc-container:has(mobile-starlight-toc details:not([open])) {
            backdrop-filter: blur(var(--blur1));
            background: linear-gradient(
                rgba(var(--sl-color-bg-rgb) / 1) 8px,
                rgba(var(--sl-color-bg-rgb) / 0)
            );
        }
    }
</style>
